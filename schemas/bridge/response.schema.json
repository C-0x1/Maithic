{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bridge response",
  "description": "One line of the Bridge's answer stream: a JSON-RPC 2.0 response with a result or a typed error, never both.",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "result": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "../common.schema.json#/$defs/error_code"
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "jsonrpc",
    "id"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "result"
      ]
    },
    {
      "required": [
        "error"
      ]
    }
  ]
}
