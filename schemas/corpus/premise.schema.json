{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Premise record",
  "description": "One constant that the proof term of a theorem refers to: a lemma it applies, a definition it unfolds, an instance it uses.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "maithic.corpus.premise/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "theorem": {
      "type": "string",
      "minLength": 1
    },
    "module": {
      "type": "string"
    },
    "premise": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema",
    "id",
    "theorem",
    "module",
    "premise"
  ],
  "additionalProperties": false
}
