{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repair report",
  "description": "What was done about each breakage of a Lean file. A breakage is repaired at one of three stages: by a rule, which replaced a name or wrote down a suggestion of Lean and needed no model; by a model, which was asked for the smallest change to a proof, in the round given; or by the prover, which proved the statement again from nothing, with the proposer that found the proof. Every repair was compiled by Lean before it was kept, and a model's repair only counts if the theorem states what it stated before. `tried` is the number of edits or proofs given to Lean for the breakage, `changed_lines` how many lines differ between the text before and after. `remaining` is what Lean still reports when the whole repaired file is checked at the end; the run is clean when that is nothing. `written` says whether the repaired text was written to the file.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "maithic.mend.report/1"
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "properties": {
        "breakages": {
          "type": "integer",
          "minimum": 0
        },
        "repaired": {
          "type": "integer",
          "minimum": 0
        },
        "unrepaired": {
          "type": "integer",
          "minimum": 0
        },
        "by_rule": {
          "type": "integer",
          "minimum": 0
        },
        "by_model": {
          "type": "integer",
          "minimum": 0
        },
        "by_prover": {
          "type": "integer",
          "minimum": 0
        },
        "remaining": {
          "type": "integer",
          "minimum": 0
        },
        "clean": {
          "type": "boolean"
        },
        "checks": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "breakages",
        "repaired",
        "unrepaired",
        "by_rule",
        "by_model",
        "by_prover",
        "remaining",
        "clean",
        "checks"
      ],
      "additionalProperties": false
    },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "declaration": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "class": {
            "enum": [
              "unknown-identifier",
              "deprecated",
              "unsolved-goals",
              "type-mismatch",
              "suggestion",
              "other"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "error": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "repaired",
              "unrepaired"
            ]
          },
          "stage": {
            "enum": [
              "rule",
              "model",
              "prove",
              "none"
            ]
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "round": {
            "type": "integer",
            "minimum": 1
          },
          "proposer": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "tried": {
            "type": "integer",
            "minimum": 0
          },
          "changed_lines": {
            "type": "integer",
            "minimum": 0
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "declaration",
          "line",
          "class",
          "severity",
          "error",
          "outcome",
          "stage",
          "tried",
          "changed_lines",
          "before"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "repaired"
                }
              }
            },
            "then": {
              "required": [
                "after",
                "description"
              ],
              "properties": {
                "stage": {
                  "enum": [
                    "rule",
                    "model",
                    "prove"
                  ]
                }
              }
            },
            "else": {
              "required": [
                "reason"
              ],
              "properties": {
                "stage": {
                  "const": "none"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "const": "rule"
                }
              }
            },
            "then": {
              "required": [
                "rule"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "const": "model"
                }
              }
            },
            "then": {
              "required": [
                "round"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "stage": {
                  "const": "prove"
                }
              }
            },
            "then": {
              "required": [
                "proposer"
              ]
            }
          }
        ]
      }
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "declaration": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "theorem",
              "lemma"
            ]
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 0
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "class": {
            "enum": [
              "unknown-identifier",
              "deprecated",
              "unsolved-goals",
              "type-mismatch",
              "suggestion",
              "other"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "error": {
            "type": "string"
          },
          "diagnostics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "enum": [
                    "error",
                    "warning",
                    "info"
                  ]
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "column": {
                  "type": "integer",
                  "minimum": 0
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "severity",
                "line",
                "column",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "context": {
            "type": "string"
          },
          "first_line": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "file",
          "declaration",
          "line",
          "column",
          "severity",
          "class",
          "error",
          "diagnostics",
          "context",
          "first_line"
        ],
        "additionalProperties": false
      }
    },
    "written": {
      "type": "boolean"
    },
    "gateway": {
      "$ref": "../gateway/account.schema.json"
    }
  },
  "required": [
    "schema",
    "file",
    "summary",
    "repairs",
    "remaining"
  ],
  "additionalProperties": false
}
