{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scan for breakage",
  "description": "What Lean reports about Lean files, collected by declaration and put in classes. A breakage is a theorem Lean reports a problem with, or a problem outside every theorem: a name that is gone (unknown-identifier), a name that is deprecated, a tactic that no longer closes its goal (unsolved-goals), a term of the wrong type (type-mismatch), a suggestion of Lean that was never written down, or another error. The diagnostics of one theorem are one breakage, classed by its first error. The context is the text of the theorem, or the line of the file, the problem is in. A scan changes nothing.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "maithic.mend.scan/1"
    },
    "summary": {
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "broken_files": {
          "type": "integer",
          "minimum": 0
        },
        "breakages": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "by_class": {
          "type": "object",
          "properties": {
            "unknown-identifier": {
              "type": "integer",
              "minimum": 0
            },
            "deprecated": {
              "type": "integer",
              "minimum": 0
            },
            "unsolved-goals": {
              "type": "integer",
              "minimum": 0
            },
            "type-mismatch": {
              "type": "integer",
              "minimum": 0
            },
            "suggestion": {
              "type": "integer",
              "minimum": 0
            },
            "other": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "unknown-identifier",
            "deprecated",
            "unsolved-goals",
            "type-mismatch",
            "suggestion",
            "other"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "files",
        "broken_files",
        "breakages",
        "errors",
        "by_class"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "breakages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "declaration": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "theorem",
                    "lemma"
                  ]
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "column": {
                  "type": "integer",
                  "minimum": 0
                },
                "severity": {
                  "enum": [
                    "error",
                    "warning",
                    "info"
                  ]
                },
                "class": {
                  "enum": [
                    "unknown-identifier",
                    "deprecated",
                    "unsolved-goals",
                    "type-mismatch",
                    "suggestion",
                    "other"
                  ]
                },
                "detail": {
                  "type": "string",
                  "minLength": 1
                },
                "error": {
                  "type": "string"
                },
                "diagnostics": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "severity": {
                        "enum": [
                          "error",
                          "warning",
                          "info"
                        ]
                      },
                      "line": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "column": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "severity",
                      "line",
                      "column",
                      "text"
                    ],
                    "additionalProperties": false
                  }
                },
                "context": {
                  "type": "string"
                },
                "first_line": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "file",
                "declaration",
                "line",
                "column",
                "severity",
                "class",
                "error",
                "diagnostics",
                "context",
                "first_line"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "file",
          "breakages"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "summary",
    "files"
  ],
  "additionalProperties": false
}
