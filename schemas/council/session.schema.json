{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Council session",
  "description": "One session of the council on one theorem. `problem` is the theorem as it is written, with the file it stands in. `settings` holds the rounds, the roles with the tools each is handed, and the schedule. `turns` is what the coordinator collected from each turn: the role, its task, how the turn ended, what it posted and what it cost. `board` is the blackboard: every item that was posted, with its author and the items it refers to. A claim carries its status and the evidence the status rests on, each piece made from an answer of Lean; a proof carries what Lean said about it. `messages` is the transcript, in the order the messages were sent. `answer` is the synthesis: the status of the claim, the proof Lean accepted when there is one, the items the answer is built from, each confirmed by Lean, and the count of what was said and set aside. A claim is `verified` only when Lean's kernel accepted a proof of it within the trust policy. `budget` gives the limits, what was spent, and the limit that ended the session when one did.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "maithic.council.session/1"
    },
    "problem": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "theorem": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file",
        "theorem",
        "statement",
        "line"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "rounds": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "integer",
          "minimum": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "boolean"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "enum": [
                  "researcher",
                  "prover",
                  "critic",
                  "verifier"
                ]
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "tasks": {
                "type": "array",
                "items": {
                  "enum": [
                    "examine",
                    "research",
                    "prove",
                    "verify",
                    "critique"
                  ]
                }
              },
              "uses_model": {
                "type": "boolean"
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "name",
              "purpose",
              "tasks",
              "uses_model",
              "tools"
            ],
            "additionalProperties": false
          }
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "rounds",
        "candidates",
        "policy",
        "model",
        "roles",
        "schedule"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "conjectured",
        "formalized",
        "refuted",
        "verified"
      ]
    },
    "ending": {
      "type": "object",
      "properties": {
        "reason": {
          "enum": [
            "settled",
            "rounds",
            "budget",
            "stopped"
          ]
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    },
    "answer": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "conjectured",
            "formalized",
            "refuted",
            "verified"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "proof": {
          "type": "string",
          "minLength": 1
        },
        "proof_item": {
          "type": "integer",
          "minimum": 1
        },
        "axioms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "counterexample": {
          "type": "string"
        },
        "counterexample_item": {
          "type": "integer",
          "minimum": 1
        },
        "components": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "set_aside": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "lean": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "statement",
        "text",
        "components",
        "set_aside"
      ],
      "additionalProperties": false
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "round": {
            "type": "integer",
            "minimum": 0
          },
          "task": {
            "enum": [
              "examine",
              "research",
              "prove",
              "verify",
              "critique"
            ]
          },
          "role": {
            "enum": [
              "researcher",
              "prover",
              "critic",
              "verifier"
            ]
          },
          "status": {
            "enum": [
              "done",
              "idle",
              "failed"
            ]
          },
          "summary": {
            "type": "string"
          },
          "posted": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "model_calls": {
            "type": "integer",
            "minimum": 0
          },
          "lean_calls": {
            "type": "integer",
            "minimum": 0
          },
          "seconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "number",
          "round",
          "task",
          "role",
          "status",
          "summary",
          "posted",
          "model_calls",
          "lean_calls",
          "seconds"
        ],
        "additionalProperties": false
      }
    },
    "board": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "definition",
              "statement",
              "claim",
              "proof",
              "counterexample",
              "note",
              "question"
            ]
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "round": {
            "type": "integer",
            "minimum": 0
          },
          "at": {
            "type": "number",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string"
          },
          "refers": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "checked": {
            "const": true
          },
          "status": {
            "enum": [
              "conjectured",
              "formalized",
              "refuted",
              "verified"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "elaborated",
                    "proved",
                    "disproved"
                  ]
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "axioms": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "policy": {
                  "type": "string",
                  "minLength": 1
                },
                "lean": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "statement"
              ],
              "additionalProperties": false
            }
          },
          "examined": {
            "enum": [
              "unexamined",
              "accepted",
              "rejected"
            ]
          },
          "lean": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "author",
          "round",
          "at",
          "title",
          "body"
        ],
        "additionalProperties": false
      }
    },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "at": {
            "type": "number",
            "minimum": 0
          },
          "round": {
            "type": "integer",
            "minimum": 0
          },
          "sender": {
            "type": "string",
            "minLength": 1
          },
          "recipients": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "performative": {
            "enum": [
              "request",
              "inform",
              "propose",
              "critique",
              "verdict",
              "decline"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          },
          "refers": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "seq",
          "at",
          "round",
          "sender",
          "recipients",
          "performative",
          "subject",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cost": {
              "type": "number",
              "minimum": 0
            },
            "seconds": {
              "type": "number",
              "minimum": 0
            },
            "lean_calls": {
              "type": "integer",
              "minimum": 0
            },
            "model_calls": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "tokens",
            "cost",
            "seconds",
            "lean_calls",
            "model_calls"
          ],
          "additionalProperties": false
        },
        "prices": {
          "type": "object",
          "properties": {
            "input": {
              "type": "number",
              "minimum": 0
            },
            "output": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "input",
            "output"
          ],
          "additionalProperties": false
        },
        "spent": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cost": {
              "type": "number",
              "minimum": 0
            },
            "seconds": {
              "type": "number",
              "minimum": 0
            },
            "lean_calls": {
              "type": "integer",
              "minimum": 0
            },
            "model_calls": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "input_tokens",
            "output_tokens",
            "cost",
            "seconds",
            "lean_calls",
            "model_calls"
          ],
          "additionalProperties": false
        },
        "exhausted": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "limits",
        "spent"
      ],
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "properties": {
        "lean_check": {
          "type": "integer",
          "minimum": 0
        },
        "lookup": {
          "type": "integer",
          "minimum": 0
        },
        "elaborate": {
          "type": "integer",
          "minimum": 0
        },
        "check_proof": {
          "type": "integer",
          "minimum": 0
        },
        "prove": {
          "type": "integer",
          "minimum": 0
        },
        "refute": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "lean_check",
        "lookup",
        "elaborate",
        "check_proof",
        "prove",
        "refute"
      ],
      "additionalProperties": false
    },
    "written": {
      "type": "boolean"
    },
    "gateway": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "problem",
    "settings",
    "status",
    "ending",
    "answer",
    "turns",
    "board",
    "messages",
    "budget",
    "tools"
  ],
  "additionalProperties": false
}
