{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verifier verdict",
  "description": "What a verifier found about a property, with the network and the boxes written exactly, as integers and fractions. verified comes with boxes, one for each layer, that the certificate checker can check; violated comes with a counterexample, a point of the input box and the exact output of the network at it; unknown comes with the reason. A verdict is a claim of a program that is not trusted.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "maithic.nnv.verdict/1"
    },
    "verdict": {
      "enum": [
        "verified",
        "violated",
        "unknown"
      ]
    },
    "network": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "activation": {
            "enum": [
              "relu",
              "identity"
            ]
          },
          "neurons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "weights": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^-?[0-9]+(/[0-9]+)?$"
                  }
                },
                "bias": {
                  "type": "string",
                  "pattern": "^-?[0-9]+(/[0-9]+)?$"
                }
              },
              "required": [
                "weights",
                "bias"
              ]
            }
          }
        },
        "required": [
          "activation",
          "neurons"
        ]
      }
    },
    "input": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^-?[0-9]+(/[0-9]+)?$"
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "output": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^-?[0-9]+(/[0-9]+)?$"
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "boxes": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^-?[0-9]+(/[0-9]+)?$"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "counterexample": {
      "type": "object",
      "properties": {
        "point": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^-?[0-9]+(/[0-9]+)?$"
          }
        },
        "output": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^-?[0-9]+(/[0-9]+)?$"
          }
        }
      },
      "required": [
        "point",
        "output"
      ]
    },
    "reason": {
      "type": "string"
    },
    "engine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "version",
        "parameters"
      ]
    }
  },
  "required": [
    "schema",
    "verdict",
    "network",
    "input",
    "output"
  ]
}
