{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gateway account",
  "description": "What a run cost in model calls: totals, and one usage record per call. A record holds no prompt, no answer and no key.",
  "$defs": {
    "record": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "served_by": {
          "enum": [
            "live",
            "replay",
            "mock",
            "scripted",
            "off",
            "record"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "error_class": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "started_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "purpose",
        "provider",
        "model",
        "served_by",
        "ok",
        "input_tokens",
        "output_tokens",
        "started_at",
        "elapsed_ms"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "mode": {
      "$ref": "../common.schema.json#/$defs/gateway_mode"
    },
    "calls": {
      "type": "integer",
      "minimum": 0
    },
    "failed_calls": {
      "type": "integer",
      "minimum": 0
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "required": [
    "mode",
    "calls",
    "failed_calls",
    "input_tokens",
    "output_tokens",
    "records"
  ],
  "additionalProperties": false
}
