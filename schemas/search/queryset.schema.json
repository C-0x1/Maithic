{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retrieval query set",
  "description": "The ground truth of a retrieval evaluation: queries, and for each the declarations that answer it. A relevant declaration is an object with a positive whole grade, or just its name, which means grade 1.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "maithic.search.queryset/1"
    },
    "name": {
      "type": "string"
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "relevant": {
            "type": "array",
            "minItems": 1,
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "grade": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "text",
          "relevant"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "name",
    "queries"
  ],
  "additionalProperties": false
}
