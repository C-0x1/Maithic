{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retrieval rankings",
  "description": "What one engine returned for the queries of a query set: for each query the declarations in ranked order and the time the query took.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "maithic.search.rankings/1"
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "queryset": {
      "type": "string"
    },
    "config": {
      "type": "object"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "ranked": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "elapsed_ms": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "query",
          "ranked",
          "elapsed_ms"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "engine",
    "results"
  ],
  "additionalProperties": false
}
