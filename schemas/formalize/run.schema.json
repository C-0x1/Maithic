{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formalization run",
  "description": "One informal problem and the Lean statements written for it. `problem` is the intake record: the text as given, the text in one spelling, what is asked, and the formulas, numbers, symbols and phrases found in it, each with its place in the text as given. Each candidate carries the statement as a model drafted it and as it stood at the end, the record of its elaboration with every attempt and what Lean said, and, when it elaborated and Lean did not show it to be the statement of an earlier candidate, the checks that were made on it. `vacuity` and `counterexample` rest on proofs that Lean accepted and reject a statement; the other checks are evidence, and flag. `agreement` is a model's score, from 0 to 10, of how well its own reading of the statement agrees with the problem. A candidate is `chosen`, `kept` behind a better one, a `duplicate`, `rejected` or `failed`. The status is `formalized` when a statement was chosen that no check flagged, `flagged` when the chosen statement deserves a second look, and `none` when no candidate was left. `lean` is the chosen statement as a Lean file, with `sorry` for a proof: nothing in a run proves a statement.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "maithic.formalize.run/1"
    },
    "problem": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "enum": [
            "prove",
            "find"
          ]
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "formula",
                  "number",
                  "symbol",
                  "quantifier",
                  "constraint",
                  "task"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "stop": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "kind",
              "text",
              "start",
              "stop"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "origin",
        "source",
        "text",
        "task",
        "elements"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 1
        },
        "rounds": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "candidates",
        "rounds",
        "name",
        "imports"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "formalized",
        "flagged",
        "none"
      ]
    },
    "note": {
      "type": "string"
    },
    "chosen": {
      "type": "integer",
      "minimum": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "drafted": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "reading": {
            "type": "string"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "origin": {
                "enum": [
                  "draft",
                  "repair",
                  "given"
                ]
              },
              "provider": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "round": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "origin",
              "round"
            ],
            "additionalProperties": false
          },
          "elaboration": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "elaborated",
                  "failed"
                ]
              },
              "first_try": {
                "type": "boolean"
              },
              "repairs": {
                "type": "integer",
                "minimum": 0
              },
              "statement": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "history": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "round": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "elaborated": {
                      "type": "boolean"
                    },
                    "error_class": {
                      "enum": [
                        "unknown-constant",
                        "unknown-module",
                        "failed-instance",
                        "type-mismatch",
                        "ambiguous",
                        "syntax",
                        "other"
                      ]
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "round",
                    "statement",
                    "elaborated"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "status",
              "first_try",
              "repairs",
              "history"
            ],
            "additionalProperties": false
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "enum": [
                    "vacuity",
                    "counterexample",
                    "triviality",
                    "numbers",
                    "variables",
                    "traps",
                    "back-translation",
                    "round-trip"
                  ]
                },
                "outcome": {
                  "enum": [
                    "passed",
                    "failed",
                    "flagged",
                    "skipped"
                  ]
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "outcome"
              ],
              "additionalProperties": false
            }
          },
          "english": {
            "type": "string"
          },
          "agreement": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "differences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "verdict": {
            "enum": [
              "chosen",
              "kept",
              "duplicate",
              "rejected",
              "failed"
            ]
          },
          "duplicate_of": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "relation": {
                "enum": [
                  "identical",
                  "definitional"
                ]
              }
            },
            "required": [
              "id",
              "relation"
            ],
            "additionalProperties": false
          },
          "reason": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "name",
          "drafted",
          "statement",
          "reading",
          "provenance",
          "elaboration",
          "verdict"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "drafted": {
          "type": "integer",
          "minimum": 0
        },
        "elaborated_first_try": {
          "type": "integer",
          "minimum": 0
        },
        "repaired": {
          "type": "integer",
          "minimum": 0
        },
        "elaborated": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "kept": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "drafted",
        "elaborated_first_try",
        "repaired",
        "elaborated",
        "failed",
        "duplicates",
        "rejected",
        "kept"
      ],
      "additionalProperties": false
    },
    "lean": {
      "type": "string",
      "minLength": 1
    },
    "written": {
      "type": "string",
      "minLength": 1
    },
    "gateway": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "problem",
    "settings",
    "status",
    "candidates",
    "summary"
  ],
  "additionalProperties": false
}
