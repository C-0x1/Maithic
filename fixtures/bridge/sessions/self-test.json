{
  "schema": "maithic.bridge.session/1",
  "name": "self-test",
  "title": "The server checks its own health",
  "steps": [
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "selfTest"
      },
      "expect": {
        "result": {
          "healthy": true,
          "checks": [
            {
              "passed": true
            },
            {
              "passed": true
            },
            {
              "passed": true
            },
            {
              "passed": true
            },
            {
              "name": "tactics step a proof state to its end",
              "passed": true
            }
          ]
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "guard",
        "params": {
          "candidate": "by intro h; omega"
        }
      },
      "expect": {
        "result": {
          "admitted": true,
          "rejection": ""
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "guard",
        "params": {
          "candidate": "by run_tac (IO.println \"x\" : IO Unit)"
        }
      },
      "expect": {
        "result": {
          "admitted": false
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "guard",
        "params": {
          "candidate": "by exact _root_.IO.getStdout"
        }
      },
      "expect": {
        "result": {
          "admitted": false
        }
      }
    },
    {
      "request": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "stats"
      },
      "expect": {
        "result": {
          "proofStates": 0
        }
      }
    }
  ]
}
